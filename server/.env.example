# Porta e bind do servidor
PORT=8090
BIND=0.0.0.0

# Endereço que o RELÓGIO alcança (obrigatório se o servidor estiver atrás de NAT/VPN)
# Ex.: http://192.168.0.10:8090
PUBLIC_HOST=http://192.168.0.10:8090

# Números autorizados (só dígitos, separados por vírgula)
ALLOWED_NUMBERS=5511999999999,5511888888888

# Evolution API
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE=wabridge
EVOLUTION_API_KEY=

# ffmpeg
FFMPEG_PATH=ffmpeg

# Cache de mídia
MEDIA_DIR=/tmp/wabridge-media
MEDIA_TTL_MS=1800000
MAX_UPLOAD_BYTES=26214400
