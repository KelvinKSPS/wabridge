{
  "name": "wabridge-server",
  "version": "1.0.0",
  "private": true,
  "description": "Ponte WhatsApp <-> smartwatch Huawei (Bridge server)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/unit/*.test.ts\"",
    "test:e2e": "node test/e2e.js",
    "test:mock": "node test/mock-evolution.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
