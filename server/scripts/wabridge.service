[Unit]
Description=Ponte WhatsApp <-> smartwatch (wabridge server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/orangepi/Desktop/Projects/wabridge/server
ExecStart=/usr/bin/node dist/index.js
EnvironmentFile=/home/orangepi/Desktop/Projects/wabridge/server/.env
Restart=on-failure
RestartSec=5
User=orangepi

[Install]
WantedBy=multi-user.target
